# LLM
OPENAI_API_KEY=sk-...

# 발행 채널 (SMTP). Gmail 이면 2단계 인증 후 '앱 비밀번호'를 발급해 SMTP_PASS 에 넣는다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASS=앱비밀번호16자리
MAIL_FROM=your_account@gmail.com
MAIL_TO=receiver@example.com

# (선택) 모델 교체
# NL_MODEL_CHEAP=gpt-4.1-mini
# NL_MODEL_SMART=gpt-4.1
