# LLM
OPENAI_API_KEY=sk-...

# 발행 채널 (SMTP).
#   네이버  smtp.naver.com:587   (메일 환경설정에서 POP3/SMTP 사용함 + 2단계 인증 시 앱 비밀번호)
#   다음    smtp.daum.net:465
#   지메일  smtp.gmail.com:587   (2단계 인증 후 앱 비밀번호)
# 포트 465 면 SSL, 587 이면 STARTTLS 로 자동 분기한다.
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USER=네이버아이디
SMTP_PASS=앱비밀번호
MAIL_FROM=네이버아이디@naver.com
MAIL_TO=receiver@example.com

# (선택) 모델 교체
# NL_MODEL_CHEAP=gpt-4.1-mini
# NL_MODEL_SMART=gpt-4.1
